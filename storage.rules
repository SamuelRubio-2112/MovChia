rules_version = '2';

// Reglas de Cloud Storage para MovChia.
// Los archivos de contenido (videos MP4, miniaturas, imágenes de señales) se
// guardan bajo `contents/`. Lectura pública; escritura solo para el personal
// del CMS (rol gestor o root en Firestore), con límite de 200 MB por archivo.
service firebase.storage {
  match /b/{bucket}/o {
    match /contents/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['gestor', 'root']
        && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
